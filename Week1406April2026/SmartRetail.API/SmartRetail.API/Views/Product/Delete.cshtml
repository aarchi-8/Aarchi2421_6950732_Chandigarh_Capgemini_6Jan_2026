@model SmartRetail.API.Models.Product

<!DOCTYPE html>
<html>
<head>
    <title>Delete Product</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; background: #f9f9f9; }
        .delete { background: #fff; padding: 20px; border-radius: 5px; max-width: 400px; margin: auto; }
        dt { font-weight: bold; }
        dd { margin-bottom: 10px; }
        button { padding: 8px 16px; background: #dc3545; color: #fff; border: none; border-radius: 3px; cursor: pointer; }
        a { color: #007bff; text-decoration: none; }
    </style>
</head>
<body>
    <h2>Delete Product</h2>
    <div class="delete">
        <form asp-action="Delete" method="post">
            <dl>
                <dt>ID</dt>
                <dd>@Model.Id</dd>
                <dt>Name</dt>
                <dd>@Model.Name</dd>
                <dt>Price</dt>
                <dd>@Model.Price</dd>
            </dl>
            <input asp-for="Id" type="hidden" />
            <button type="submit">Delete</button>
            <a href="/Product">Cancel</a>
        </form>
    </div>
</body>
</html>
