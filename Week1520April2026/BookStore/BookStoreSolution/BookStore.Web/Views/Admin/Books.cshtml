@using BookStore.Shared
@model PaginatedResult<BookListItem>
@{ ViewData["Title"] = "Manage Books"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2><i class="bi bi-book me-2"></i>Manage Books</h2><a asp-action="CreateBook" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add New Book</a></div>
<form method="get" class="mb-3"><div class="input-group"><input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search..." /><button type="submit" class="btn btn-outline-primary">Search</button></div></form>
@if (Model != null && Model.Items.Any())
{
    <div class="card shadow-sm"><div class="card-body p-0">
    <table class="table table-hover mb-0"><thead class="table-light"><tr><th>ID</th><th>Image</th><th>Title</th><th>Author</th><th>Category</th><th>Price</th><th>Stock</th><th style="width:160px">Actions</th></tr></thead>
    <tbody>@foreach (var b in Model.Items) { <tr><td>@b.BookId</td><td>@if (!string.IsNullOrEmpty(b.ImageUrl)) { <img src="@b.ImageUrl" alt="Book" class="img-thumbnail" style="width:50px;height:70px;object-fit:cover;" onerror="this.src='https://via.placeholder.com/50x70?text=No+Img';" /> } else { <div class="bg-light text-center" style="width:50px;height:70px;border:1px solid #dee2e6;border-radius:0.25rem;"><i class="bi bi-book text-muted" style="font-size:1.5rem;margin-top:20px;"></i></div> }</td><td class="fw-semibold">@b.Title</td><td>@b.AuthorName</td><td><span class="badge bg-secondary">@b.CategoryName</span></td><td>Rs. @b.Price</td><td>@b.Stock</td><td><a asp-action="EditBook" asp-route-id="@b.BookId" class="btn btn-sm btn-warning me-1"><i class="bi bi-pencil"></i></a><form asp-action="DeleteBook" asp-route-id="@b.BookId" method="post" class="d-inline" onsubmit="return confirm('Delete this book?')"><button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button></form></td></tr> }</tbody></table>
    </div></div>
    @if (Model.TotalPages > 1) { <nav class="mt-3"><ul class="pagination">@for (int i = 1; i <= Model.TotalPages; i++) { <li class="page-item @(i == ViewBag.Page ? "active" : "")"><a class="page-link" href="?page=@i&search=@ViewBag.Search">@i</a></li> }</ul></nav> }
}
else { <p class="text-muted">No books found.</p> }