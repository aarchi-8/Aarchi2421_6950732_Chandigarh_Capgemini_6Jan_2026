@model List<OrderView>
@{ ViewData["Title"] = "Manage Orders"; }
<h2><i class="bi bi-box-seam me-2"></i>All Orders</h2>
@if (Model.Any())
{
    <div class="card shadow-sm mt-3"><div class="card-body p-0">
    <table class="table table-hover mb-0"><thead class="table-light"><tr><th>Order #</th><th>Customer</th><th>Date</th><th>Total</th><th>Status</th><th style="width:280px">Update Status</th></tr></thead>
    <tbody>@foreach (var o in Model) { <tr><td><strong>#@o.OrderId</strong></td><td>@o.CustomerName</td><td>@o.OrderDate.ToString("dd MMM yyyy")</td><td class="fw-bold">Rs. @o.TotalAmount</td><td><span class="badge @(o.Status == "Delivered" ? "bg-success" : o.Status == "Cancelled" ? "bg-danger" : o.Status == "Shipped" ? "bg-primary" : "bg-warning text-dark")">@o.Status</span></td>
    <td><form asp-action="UpdateOrderStatus" method="post" class="d-flex gap-1"><input type="hidden" name="orderId" value="@o.OrderId" /><select name="status" class="form-select form-select-sm"><option>Pending</option><option>Confirmed</option><option>Shipped</option><option>Delivered</option><option>Cancelled</option></select><button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check"></i></button></form></td></tr> }</tbody></table>
    </div></div>
}
else { <p class="text-muted mt-3">No orders yet.</p> }