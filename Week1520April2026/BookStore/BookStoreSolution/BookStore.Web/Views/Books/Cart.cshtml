@model List<CartItem>
@{ ViewData["Title"] = "Cart"; }
<h2><i class="bi bi-cart3 me-2"></i>Shopping Cart</h2>
@if (Model.Any())
{
    <div class="card shadow-sm mt-3"><div class="card-body">
    <table class="table table-hover mb-0"><thead class="table-light"><tr><th>Book</th><th>Price</th><th>Qty</th><th>Subtotal</th><th></th></tr></thead>
    <tbody>@foreach (var item in Model) { <tr><td class="fw-semibold">@item.Title</td><td>Rs. @item.Price</td><td>@item.Qty</td><td class="fw-bold">Rs. @(item.Price * item.Qty)</td><td><form asp-action="RemoveFromCart" method="post"><input type="hidden" name="bookId" value="@item.BookId" /><button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button></form></td></tr> }</tbody>
    <tfoot><tr class="table-primary"><th colspan="3" class="text-end fs-5">Total</th><th class="fs-5">Rs. @Model.Sum(i => i.Price * i.Qty)</th><th></th></tr></tfoot></table>
    </div></div>
    <form asp-action="Checkout" method="post" class="mt-3"><button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-bag-check me-2"></i>Place Order</button></form>
}
else { <div class="text-center py-5"><i class="bi bi-cart-x display-1 text-muted"></i><p class="text-muted mt-3">Your cart is empty.</p><a asp-controller="Books" asp-action="Index" class="btn btn-primary">Browse Books</a></div> }