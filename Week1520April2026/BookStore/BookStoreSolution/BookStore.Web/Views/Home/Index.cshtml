@{ ViewData["Title"] = "Home"; }
<div class="text-center mt-5 mb-5">
    <h1 class="display-4 fw-bold text-primary"><i class="bi bi-book-half"></i> BookStore Pro</h1>
    <p class="lead text-muted mt-3">Your one-stop destination for books across India. Browse, order, and get doorstep delivery.</p>
    <div class="mt-4">
        <a asp-controller="Books" asp-action="Index" class="btn btn-primary btn-lg px-5"><i class="bi bi-search me-2"></i>Browse Books</a>
        <a asp-controller="Auth" asp-action="Register" class="btn btn-outline-primary btn-lg px-5 ms-2"><i class="bi bi-person-plus me-2"></i>Join Now</a>
    </div>
</div>
<div class="row text-center mt-5">
    <div class="col-md-4"><div class="p-4"><i class="bi bi-truck display-4 text-primary"></i><h5 class="mt-3">Fast Delivery</h5><p class="text-muted">Free delivery across 15 stores in India</p></div></div>
    <div class="col-md-4"><div class="p-4"><i class="bi bi-shield-check display-4 text-success"></i><h5 class="mt-3">Secure Payments</h5><p class="text-muted">Safe and encrypted transactions</p></div></div>
    <div class="col-md-4"><div class="p-4"><i class="bi bi-stars display-4 text-warning"></i><h5 class="mt-3">Top Authors</h5><p class="text-muted">Books from India's best writers</p></div></div>
</div>