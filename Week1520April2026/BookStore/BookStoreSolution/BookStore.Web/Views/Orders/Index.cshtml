@model List<OrderView>
@{ ViewData["Title"] = "My Orders"; }
<h2><i class="bi bi-bag-check me-2"></i>My Orders</h2>
@if (Model.Any())
{
    <div class="card shadow-sm mt-3"><div class="card-body p-0">
    <table class="table table-hover mb-0"><thead class="table-light"><tr><th>Order #</th><th>Date</th><th>Total</th><th>Status</th></tr></thead>
    <tbody>@foreach (var o in Model) { <tr><td><strong>#@o.OrderId</strong></td><td>@o.OrderDate.ToString("dd MMM yyyy")</td><td class="fw-bold">Rs. @o.TotalAmount</td><td><span class="badge @(o.Status == "Delivered" ? "bg-success" : o.Status == "Cancelled" ? "bg-danger" : o.Status == "Shipped" ? "bg-primary" : "bg-warning text-dark")">@o.Status</span></td></tr> }</tbody></table>
    </div></div>
}
else { <div class="text-center py-5"><i class="bi bi-bag display-1 text-muted"></i><p class="text-muted mt-3">No orders yet.</p><a asp-controller="Books" asp-action="Index" class="btn btn-primary">Start Shopping</a></div> }