@{ ViewData["Title"] = "Admin Dashboard"; }
<h2 class="mb-4"><i class="bi bi-shield-lock me-2"></i>Admin Dashboard</h2>
<div class="row g-4">
    <div class="col-md-3"><a asp-action="Books" class="text-decoration-none"><div class="card bg-primary text-white shadow h-100"><div class="card-body text-center py-4"><i class="bi bi-book display-4"></i><h5 class="mt-3">Manage Books</h5><p class="mb-0 small">Add, edit, delete books</p></div></div></a></div>
    <div class="col-md-3"><a asp-action="Orders" class="text-decoration-none"><div class="card bg-success text-white shadow h-100"><div class="card-body text-center py-4"><i class="bi bi-box-seam display-4"></i><h5 class="mt-3">Manage Orders</h5><p class="mb-0 small">Track & update order status</p></div></div></a></div>
    <div class="col-md-3"><a asp-action="Categories" class="text-decoration-none"><div class="card bg-warning text-dark shadow h-100"><div class="card-body text-center py-4"><i class="bi bi-tags display-4"></i><h5 class="mt-3">Categories</h5><p class="mb-0 small">Add & manage categories</p></div></div></a></div>
    <div class="col-md-3"><a asp-action="Reports" class="text-decoration-none"><div class="card bg-danger text-white shadow h-100"><div class="card-body text-center py-4"><i class="bi bi-graph-up-arrow display-4"></i><h5 class="mt-3">Sales Report</h5><p class="mb-0 small">Revenue & top sellers</p></div></div></a></div>
</div>