@model SalesReportView
@{ ViewData["Title"] = "Sales Report"; }
<h2><i class="bi bi-graph-up-arrow me-2"></i>Sales Report</h2>
<div class="row mt-4 g-4">
    <div class="col-md-4"><div class="card border-primary shadow-sm"><div class="card-body text-center"><p class="text-muted mb-1">Total Orders</p><h2 class="text-primary fw-bold">@Model.TotalOrders</h2></div></div></div>
    <div class="col-md-4"><div class="card border-success shadow-sm"><div class="card-body text-center"><p class="text-muted mb-1">Total Revenue</p><h2 class="text-success fw-bold">Rs. @Model.TotalRevenue</h2></div></div></div>
    <div class="col-md-4"><div class="card border-info shadow-sm"><div class="card-body text-center"><p class="text-muted mb-1">Avg Order Value</p><h2 class="text-info fw-bold">Rs. @(Model.TotalOrders > 0 ? Math.Round(Model.TotalRevenue / Model.TotalOrders, 2) : 0)</h2></div></div></div>
</div>
<h4 class="mt-5"><i class="bi bi-trophy me-2"></i>Top Selling Books</h4>
@if (Model.TopBooks.Any())
{ <div class="card shadow-sm mt-2"><div class="card-body p-0"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>#</th><th>Title</th><th>Total Sold</th><th>Revenue</th></tr></thead><tbody>@{ int rank = 0; } @foreach (var b in Model.TopBooks) { rank++; <tr><td><span class="badge bg-dark">@rank</span></td><td class="fw-semibold">@b.Title</td><td>@b.TotalSold copies</td><td class="fw-bold text-success">Rs. @b.Revenue</td></tr> }</tbody></table></div></div> }
else { <p class="text-muted">No sales data yet.</p> }