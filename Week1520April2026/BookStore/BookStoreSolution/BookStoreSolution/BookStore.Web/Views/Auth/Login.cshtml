@model LoginViewModel
@{ ViewData["Title"] = "Login"; }
<div class="row justify-content-center mt-5"><div class="col-md-5">
    <div class="card shadow-sm"><div class="card-body p-4">
        <h3 class="text-center mb-4"><i class="bi bi-person-lock"></i> Login</h3>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" placeholder="you@example.com" /><span asp-validation-for="Email" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" type="password" /><span asp-validation-for="Password" class="text-danger"></span></div>
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-box-arrow-in-right me-2"></i>Login</button>
        </form>
        <p class="mt-3 text-center">New here? <a asp-action="Register">Create an account</a></p>
    </div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }