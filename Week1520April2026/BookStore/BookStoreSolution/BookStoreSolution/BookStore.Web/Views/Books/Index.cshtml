@using BookStore.Shared
@model PaginatedResult<BookListItem>

@{
    ViewData["Title"] = "Books";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-grid me-2"></i>Books</h2>
</div>

<form method="get" class="mb-4">
    <div class="input-group shadow-sm">
        <span class="input-group-text bg-white">
            <i class="bi bi-search"></i>
        </span>
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by title or author..." />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

@if (Model != null && Model.Items.Any())
{
    <div class="row">
        @foreach (var book in Model.Items)
        {
            <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                <div class="card h-100 shadow-sm border-0">

                    <!-- ✅ FIXED IMAGE -->
                    @if (!string.IsNullOrEmpty(book.ImageUrl))
                    {
                        <img src="@book.ImageUrl"
                             class="card-img-top"
                             style="height:180px;object-fit:cover"
                             alt="@book.Title"
                             onerror="this.src='https://via.placeholder.com/150x225?text=No+Image';" />
                    }
                    else
                    {
                        <img src="https://via.placeholder.com/150x225?text=No+Image"
                             class="card-img-top"
                             style="height:180px;object-fit:cover"
                             alt="No Image" />
                    }

                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title fw-bold">@book.Title</h6>

                        <p class="card-text text-muted small mb-1">
                            <i class="bi bi-person me-1"></i>@book.AuthorName
                        </p>

                        <p class="card-text small mb-2">
                            <span class="badge bg-secondary">@book.CategoryName</span>
                            <span class="text-muted">Stock: @book.Stock</span>
                        </p>

                        <p class="card-text small text-muted mb-2">
                            ImageUrl: @(book.ImageUrl ?? "null")
                        </p>

                        <p class="card-text fw-bold text-primary mt-auto">
                            Rs. @book.Price
                        </p>

                        <div class="d-flex gap-2">
                            <a asp-action="Details"
                               asp-route-id="@book.BookId"
                               class="btn btn-sm btn-outline-primary flex-fill">
                                <i class="bi bi-eye"></i> View
                            </a>

                            @if (Context.Session.GetString("UserRole") != "Admin")
                            {
                                <form asp-action="AddToCart" method="post" class="flex-fill">
                                    <input type="hidden" name="bookId" value="@book.BookId" />
                                    <input type="hidden" name="title" value="@book.Title" />
                                    <input type="hidden" name="price" value="@book.Price" />

                                    <button type="submit" class="btn btn-sm btn-success w-100">
                                        <i class="bi bi-cart-plus"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                        <a class="page-link" href="?page=@i&search=@ViewBag.Search">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-inbox display-1 text-muted"></i>
        <p class="text-muted mt-3">No books found.</p>
    </div>
}